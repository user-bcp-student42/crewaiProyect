# Copiar como .env. NUNCA commitear .env.

# ── Modelo ──────────────────────────────────────────────────────────
# copilot   : GitHub Copilot (usa la sesión de `copilot` → /login), igual que en los labs.
# crewai    : cualquier modelo soportado por CrewAI/LiteLLM (define LLM_MODEL y su API key).
# simulado  : sin modelo; genera informes de ejemplo para probar el flujo.
LLM_PROVIDER=copilot

# ID del modelo en Copilot. Para ver los disponibles: abre `copilot` y escribe /model.
COPILOT_MODEL=gpt-6-luna
# low | medium | high. Déjalo vacío si el modelo no admite esfuerzo de razonamiento.
COPILOT_REASONING_EFFORT=high
COPILOT_USE_LOGGED_IN_USER=true

# Solo con LLM_PROVIDER=crewai, por ejemplo:
# LLM_MODEL=anthropic/claude-sonnet-5-5
# ANTHROPIC_API_KEY=...
